---
import Base from '../../layouts/Base.astro';
import { getLogs, formatDate, entryPath } from '../../lib/content';

const logs = await getLogs();
---

<Base title="Worklog" description="Short, frequent worklog entries.">
  <section class="wrap">
    <h1 class="page-title">Worklog</h1>
    {
      logs.length > 0 ? (
        <ul class="feed-list">
          {logs.map((entry) => (
            <li class="feed-item">
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              <span class="badge">log</span>
              <a href={entryPath('log', entry.id)}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )
    }
  </section>
</Base>
